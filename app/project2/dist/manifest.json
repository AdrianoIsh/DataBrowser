{
	"_version": "1.90.0",
	"sap.app": {
		"id": "com.databrowser.usuariosmonitor.project2",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.2"
		},
		"title": "Administração de Pacotes/Usuários",
		"description": "Monitor CPI",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:lrop",
			"version": "1.34.0",
			"toolsId": "21b9129f-460e-4710-9e00-2e39e6ccc115"
		},
		"dataSources": {
			"mainService": {
				"uri": "odata/v4/usuarios-monitor/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"UsuarioPacote-manage": {
					"semanticObject": "UsuarioPacote",
					"action": "manage",
					"title": "Administração de Pacotes/Usuários",
					"subTitle": "Monitor CPI",
					"icon": "sap-icon://user-settings",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.154.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.databrowser.usuariosmonitor.project2.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"resources": {
			"css": []
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "UsuarioPacoteList",
					"target": "UsuarioPacoteList"
				},
				{
					"pattern": "UsuarioPacote({key}):?query:",
					"name": "UsuarioPacoteObjectPage",
					"target": "UsuarioPacoteObjectPage"
				}
			],
			"targets": {
				"UsuarioPacoteList": {
					"type": "Component",
					"id": "UsuarioPacoteList",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"contextPath": "/UsuarioPacote",
							"variantManagement": "Page",
							"initialLoad": "Enabled",
							"navigation": {
								"UsuarioPacote": {
									"detail": {
										"route": "UsuarioPacoteObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									}
								}
							}
						}
					}
				},
				"UsuarioPacoteObjectPage": {
					"type": "Component",
					"id": "UsuarioPacoteObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/UsuarioPacote"
						}
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.fe": {
		"app": {
			"enableLazyLoading": true
		}
	},
	"sap.cloud": {
		"public": true,
		"service": "DataBrowser.service"
	}
}